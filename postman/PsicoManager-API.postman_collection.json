        {
          "name": "Restaurar Usuário",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/restore",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "restore"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "📋 Tasks (Protected)",
      "item": [
